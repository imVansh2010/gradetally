# Local editor/agent state (contains absolute paths and machine-specific ids)
.freebuff/

# Local test harness and its hand-written fixtures. The suite stays on this
# machine. A saved gradebook page - and any fixture built from one - is an
# education record, so it is not kept anywhere: no such capture belongs in this
# tree and none is merely ignored here.
mktest.js
test-*.html

# Throwaway check helpers and their output (see .freebuff/run.md).
mk-*.js
test-all.html
wrap.html
frame-*.html
shot-*.png
check*.png

# Build intermediates. `node build.js` regenerates both from bookmarklet.js.
bookmarklet.min.js
bookmarklet.raw.txt

# Local design notes, kept on disk only
design-system/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# npm droppings. Node builtins are the only require() targets in this repo, so
# nothing here should ever exist; ignored so an accidental `npm install` can
# never get tracked.
node_modules/
package.json
package-lock.json
